# Root services for LineageOS userdebug. Existing init -> su policy is required.
# Android remains globally enforcing; su is the ROM's permissive debug domain.
service phone-hardware /system/bin/sh /system_ext/bin/phone-services hardware
    class late_start
    user root
    group root shell inet net_admin net_raw readproc wakelock sdcard_rw
    seclabel u:r:su:s0
    disabled
    oneshot

service phone-stack /system/bin/sh /system_ext/bin/phone-services stack
    class late_start
    user root
    group root shell inet net_admin net_raw readproc wakelock sdcard_rw
    seclabel u:r:su:s0
    disabled
    restart_period 30

service phone-sysutils /system/bin/sh /system_ext/bin/phone-services sysutils
    class late_start
    user root
    group root shell inet net_admin net_raw readproc wakelock sdcard_rw
    seclabel u:r:su:s0
    disabled
    restart_period 30

on property:sys.boot_completed=1
    start phone-hardware
    start phone-stack
    start phone-sysutils
